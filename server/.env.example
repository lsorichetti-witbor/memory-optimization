OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app
# Identity every memory is written under and filtered by. It is part of the
# search filter, so changing it hides every memory written under the old
# value - the search simply returns nothing, which looks exactly like an
# empty store. Set it once and leave it.
MEM0_USER=

# Host port mappings. The container-side ports are fixed; these are what the
# ports are published as on your machine. POSTGRES_PORT above is the port the
# API uses to reach postgres INSIDE the docker network - it is not this.
MEM0_API_PORT=8888
POSTGRES_HOST_PORT=8432
DASHBOARD_PORT=3000


# Default LLM and embedder provider. Must be in BUNDLED_*_PROVIDERS (see server/main.py).
# anthropic is LLM-only: it ships no embedding model. gemini covers both legs.
MEM0_DEFAULT_LLM_PROVIDER=openai
MEM0_DEFAULT_EMBEDDER_PROVIDER=openai
# Gemini model ids retire without notice: gemini-2.0-flash now 404s with
# 'no longer available'. Confirm a model with client.models.list() before
# pinning it rather than trusting the id in an error message or a doc.

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Width of the pgvector embedding column. MUST match the embedder's output:
# text-embedding-3-small = 1536, models/gemini-embedding-001 = 768 by default.
# Changing this after the collection exists requires dropping the table.
MEM0_EMBEDDING_DIMS=1536

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
